<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Assistant Google : « Ouvre focus / coach / statistiques / journal sur PepsGoal » -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent android:action="fr.pepsgoal.app.FEATURE" android:targetPackage="@string/pkg" android:targetClass="fr.pepsgoal.app.MainActivity">
            <parameter android:name="feature" android:key="feature" />
        </intent>
    </capability>
    <shortcut android:shortcutId="new" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_new" android:shortcutLongLabel="@string/sc_new_long">
        <intent android:action="fr.pepsgoal.app.NEW_GOAL" android:targetPackage="@string/pkg" android:targetClass="fr.pepsgoal.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="today" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_today" android:shortcutLongLabel="@string/sc_today_long">
        <intent android:action="fr.pepsgoal.app.TODAY" android:targetPackage="@string/pkg" android:targetClass="fr.pepsgoal.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="messages" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_msgs" android:shortcutLongLabel="@string/sc_msgs_long">
        <intent android:action="fr.pepsgoal.app.MESSAGES" android:targetPackage="@string/pkg" android:targetClass="fr.pepsgoal.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="focus" android:enabled="true" android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_focus" android:shortcutLongLabel="@string/sc_focus_long">
        <intent android:action="fr.pepsgoal.app.FOCUS" android:targetPackage="@string/pkg" android:targetClass="fr.pepsgoal.app.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE"><parameter-binding android:key="feature" android:value="focus" /></capability-binding>
    </shortcut>
</shortcuts>
