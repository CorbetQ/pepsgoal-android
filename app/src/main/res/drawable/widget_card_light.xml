<?xml version="1.0" encoding="utf-8"?>
<!-- Carte de widget : surface pleine avec sa marche (rectangle du bord décalé de 3 dp sous la carte) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle"><corners android:radius="18dp" /><solid android:color="#FFF2DED1" /></shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle"><corners android:radius="18dp" /><solid android:color="#FFFFFFFF" /><stroke android:width="2dp" android:color="#FFF2DED1" /></shape>
    </item>
</layer-list>
